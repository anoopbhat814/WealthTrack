{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@wealthtrack/types": ["packages/types/src"],
      "@wealthtrack/utils": ["packages/utils/src"],
      "@/*": ["apps/web/src/*"]
    }
  },
  "exclude": ["node_modules", "services"]
}
